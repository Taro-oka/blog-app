{
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "overrides": [
    {
      "files": ["*.php"],
      "options": {
        "singleQuote": true,
        "parser": "php",
        "plugins": ["@prettier/plugin-php"]
      }
    }
  ]
}
